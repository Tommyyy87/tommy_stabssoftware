{
  "name": "@stabs/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "node --test dist/runtime-config.test.js dist/modules/auth/auth.service.test.js dist/modules/auth/prisma-auth.store.test.js dist/modules/incidents/incidents.service.test.js dist/modules/journal/journal.service.test.js dist/modules/messages/messages.service.test.js dist/modules/messages/prisma-messages.store.test.js dist/shared/demo-store.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:foundation": "node scripts/verify-foundation.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@prisma/client": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
